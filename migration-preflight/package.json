{
  "name": "migration-preflight",
  "version": "0.1.0",
  "private": true,
  "main": "dist/handler.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "package": "npm run build && powershell -NoProfile -Command \"Compress-Archive -Path dist\\* -DestinationPath preflight-lambda.zip -Force\"",
    "test": "jest --runInBand",
    "check:pretty": "prettier --check \"**/*.{js,ts,json}\"",
    "fix:pretty": "prettier --write \"**/*.{js,ts,json}\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.957.0",
    "@aws-sdk/client-secrets-manager": "^3.943.0",
    "@aws-sdk/client-sfn": "^3.957.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pg": "^8.16.3",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.30",
    "@types/pg": "^8.15.5",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
