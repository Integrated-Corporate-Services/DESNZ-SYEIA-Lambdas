    "devDependencies": {
        "eslint": "^8.0.0",
        "jest": "^30.2.0",
        "@types/jest": "^29.5.0"
    },
    "dependencies": {
        "pg": "^8.20.0",
        "winston": "^3.11.0",
        "@aws-sdk/client-sqs": "^3.0.0",
        "@aws-sdk/client-ecs": "^3.0.0",
        "@aws-sdk/client-cloudwatch": "^3.0.0"
    }
}
