{
    "type": "module",
    "scripts": {
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "deploy": "zip -r lambda.zip . && echo 'Upload lambda.zip to AWS Lambda'",
        "lint": "eslint .",
        "start": "node handler.js"
    },
