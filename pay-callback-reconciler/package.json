{
    "type": "module",
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "deploy": "npm run build && zip -r lambda.zip dist package.json package-lock.json node_modules && echo 'Upload lambda.zip to AWS Lambda'",
        "lint": "eslint . --ext .ts,.js",
        "lint:fix": "eslint . --ext .ts,.js --fix",
        "type-check": "tsc --noEmit",
        "start": "node dist/handler.js",
        "dev": "ts-node-esm handler.ts"
    },
    "description": "Lambda for processing GOV.UK Pay webhooks via SQS - triggered by backend webhook service",
    "version": "2.0.0",
    "engines": {
        "node": "18.x"
    },
    "name": "payment-processor-webhook-lambda",
    "main": "dist/handler.js",
    "types": "dist/handler.d.ts",
    "devDependencies": {
        "@types/aws-lambda": "^8.10.161",
        "@types/jest": "^29.5.0",
        "@types/node": "^18.19.0",
        "@types/pg": "^8.10.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.0.0",
        "jest": "^30.2.0",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.0"
    },
    "dependencies": {
        "@aws-sdk/client-cloudwatch": "^3.0.0",
        "@aws-sdk/client-ecs": "^3.0.0",
        "@aws-sdk/client-sqs": "^3.0.0",
        "pg": "^8.20.0"
    }
}
