{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/s37-application.schema.json",
  "title": "S37 Application",
  "type": "object",
  "additionalProperties": false,
  "required": ["applicationId", "desnzReference", "formType", "metadata", "sections"],
  "properties": {
    "applicationId": { "type": "string", "format": "uuid" },
    "desnzReference": { "type": "string" },
    "formType": { "type": "string" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "schemaVersion"],
      "properties": {
        "source": { "type": "string" },
        "schemaVersion": { "type": "integer" }
      }
    },
    "sections": {
      "type": "object",
      "required": ["networkOperator", "route", "assetInformation", "supportingDocuments"],
      "properties": {
        "networkOperator": {
          "type": "object",
          "required": ["operator_ref", "application_party"],
          "properties": {
            "operator_ref": { "type": "string" },
            "application_party": { "type": "object" }
          }
        }
      }
    }
  }
}

