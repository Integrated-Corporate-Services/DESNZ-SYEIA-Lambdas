{
  "name": "rds-to-salesforce-lambda",
  "version": "1.0.0",
  "description": "AWS Lambda for syncing RDS events to Salesforce via REST or AppFlow",
  "type": "module",
  "main": "handler.js",
  "scripts": {
    "start": "node handler.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/client-secrets-manager": "^3.943.0",
    "@aws-sdk/client-sqs": "^3.943.0",
    "@aws-sdk/client-ssm": "^3.943.0",
    "axios": "^1.7.9",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.3",
    "winston": "^3.18.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "ajv": "^8.17.1",
    "jest": "^30.2.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  }
}
