{
  "info": {
    "name": "Payment Webhook Integration",
    "description": "API collection for testing GOV.UK Pay webhook integration with inbound-event-receiver",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "12345"
  },
  "item": [
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "1. New Payment (card_payment_succeeded)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Pay-Signature",
                "value": "{{signature}}",
                "description": "HMAC-SHA256 signature - auto-generated by pre-request script"
              },
              {
                "key": "X-Webhook-Id",
                "value": "{{$randomUUID}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"webhook_message_id\": \"evt_{{$timestamp}}_created\",\n  \"api_version\": 1,\n  \"event_type\": \"card_payment_succeeded\",\n  \"created_date\": \"{{$isoTimestamp}}\",\n  \"resource_id\": \"pay_{{$timestamp}}_new\",\n  \"resource_type\": \"payment\",\n  \"resource\": {\n    \"payment_id\": \"pay_{{$timestamp}}_new\",\n    \"payment_provider\": \"worldpay\",\n    \"amount\": 2500,\n    \"reference\": \"TEST-REF-001\",\n    \"description\": \"Postman test payment\",\n    \"state\": {\n      \"status\": \"success\",\n      \"finished\": true\n    },\n    \"return_url\": \"https://example.com/return\",\n    \"created_date\": \"{{$isoTimestamp}}\"\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3000/callback/payment",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["callback", "payment"]
            },
            "description": "Creates a new payment webhook event"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const crypto = require('crypto');",
                  "",
                  "// Webhook signing key (matches integration test)",
                  "const signingKey = 'test-signing-key-456';",
                  "",
                  "// Get request body",
                  "const requestBody = pm.request.body.raw;",
                  "",
                  "// Generate HMAC-SHA256 signature",
                  "const signature = crypto",
                  "  .createHmac('sha256', signingKey)",
                  "  .update(requestBody)",
                  "  .digest('hex');",
                  "",
                  "// Set signature in environment",
                  "pm.environment.set('signature', signature);",
                  "",
                  "console.log('Generated signature:', signature);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Payment Captured",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Pay-Signature",
                "value": "{{signature}}"
              },
              {
                "key": "X-Webhook-Id",
                "value": "{{$randomUUID}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"webhook_message_id\": \"evt_{{$timestamp}}_captured\",\n  \"api_version\": 1,\n  \"event_type\": \"card_payment_captured\",\n  \"created_date\": \"{{$isoTimestamp}}\",\n  \"resource_id\": \"pay_existing_123\",\n  \"resource_type\": \"payment\",\n  \"resource\": {\n    \"payment_id\": \"pay_existing_123\",\n    \"payment_provider\": \"worldpay\",\n    \"amount\": 2500,\n    \"reference\": \"TEST-REF-001\",\n    \"description\": \"Payment captured\",\n    \"state\": {\n      \"status\": \"capturable\",\n      \"finished\": false\n    },\n    \"capture_submit_time\": \"{{$isoTimestamp}}\"\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3000/callback/payment",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["callback", "payment"]
            },
            "description": "Payment funds captured from customer"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const crypto = require('crypto');",
                  "const signingKey = 'test-signing-key-456';",
                  "const requestBody = pm.request.body.raw;",
                  "const signature = crypto.createHmac('sha256', signingKey).update(requestBody).digest('hex');",
                  "pm.environment.set('signature', signature);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Payment Failed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Pay-Signature",
                "value": "{{signature}}"
              },
              {
                "key": "X-Webhook-Id",
                "value": "{{$randomUUID}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"webhook_message_id\": \"evt_{{$timestamp}}_failed\",\n  \"api_version\": 1,\n  \"event_type\": \"card_payment_failed\",\n  \"created_date\": \"{{$isoTimestamp}}\",\n  \"resource_id\": \"pay_{{$timestamp}}_fail\",\n  \"resource_type\": \"payment\",\n  \"resource\": {\n    \"payment_id\": \"pay_{{$timestamp}}_fail\",\n    \"payment_provider\": \"worldpay\",\n    \"amount\": 1000,\n    \"reference\": \"TEST-REF-FAIL\",\n    \"description\": \"Failed payment test\",\n    \"state\": {\n      \"status\": \"failed\",\n      \"finished\": true,\n      \"message\": \"Payment method expired\",\n      \"code\": \"P0050\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3000/callback/payment",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["callback", "payment"]
            },
            "description": "Payment processing failed"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const crypto = require('crypto');",
                  "const signingKey = 'test-signing-key-456';",
                  "const requestBody = pm.request.body.raw;",
                  "const signature = crypto.createHmac('sha256', signingKey).update(requestBody).digest('hex');",
                  "pm.environment.set('signature', signature);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Invalid Signature (Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Pay-Signature",
                "value": "invalid_signature_12345",
                "description": "Invalid signature - request should be rejected"
              },
              {
                "key": "X-Webhook-Id",
                "value": "{{$randomUUID}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"webhook_message_id\": \"evt_{{$timestamp}}_invalid\",\n  \"api_version\": 1,\n  \"event_type\": \"card_payment_succeeded\",\n  \"created_date\": \"{{$isoTimestamp}}\",\n  \"resource_id\": \"pay_{{$timestamp}}_invalid\",\n  \"resource_type\": \"payment\",\n  \"resource\": {\n    \"payment_id\": \"pay_{{$timestamp}}_invalid\",\n    \"amount\": 1500,\n    \"reference\": \"TEST-INVALID\"\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3000/callback/payment",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["callback", "payment"]
            },
            "description": "Test with invalid signature - should return 401"
          },
          "response": []
        }
      ],
      "description": "GOV.UK Pay webhook endpoints"
    },
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "Inbound Receiver Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["health"]
            },
            "description": "Check if inbound-event-receiver is healthy"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "signingKey",
      "value": "test-signing-key-456",
      "type": "string",
      "description": "HMAC-SHA256 signing key for webhooks"
    }
  ]
}
